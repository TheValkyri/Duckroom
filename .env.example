# ==============================================================================
# Duckroom Environment Configuration (.env.example)
# ==============================================================================

# Pikamc S3 Storage Configuration (Server-Only Secrets)
S3_ENDPOINT="https://s3.pikamc.vn"
S3_REGION="vn-hcm-1"
S3_BUCKET_NAME="pikamc-osi-ccccda39-9eac-43c3-ae21-894787c65678"
S3_ACCESS_KEY_ID="your-s3-access-key-id"
S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# Supabase Database & Auth Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Duckroom Owner Configuration (Server-Only)
DUCKROOM_OWNER_EMAIL="your-owner-email@example.com"

# Spotify Bridge (Server-Only, OPTIONAL — Master Plan §14).
# Without these, the import panel degrades to public oEmbed metadata
# (title/thumbnail only). Duckroom playback never depends on Spotify.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Canonical public origin used for share-link URLs (Server-Only).
# On Vercel this is auto-detected from VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL;
# set explicitly only for custom domains or non-Vercel deployments.
# DUCKROOM_PUBLIC_ORIGIN="https://duckroom.example.com"

# Client-Safe Public Variables
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
